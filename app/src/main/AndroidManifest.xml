<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.tgproxyparser">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Proxy for Telegram"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProxyParser"
        tools:replace="android:label"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ProxyParser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ProxyLoadingActivity"
            android:exported="false"
            android:theme="@style/Theme.ProxyParser" />

        <activity
            android:name=".ProxyListActivity"
            android:exported="false"
            android:theme="@style/Theme.ProxyParser" />

        <activity
            android:name=".CheckFileActivity"
            android:exported="false"
            android:theme="@style/Theme.ProxyParser" />

        <activity
            android:name=".MergeProxiesActivity"
            android:exported="false"
            android:theme="@style/Theme.ProxyParser" />


        <activity
            android:name=".TdLibCheckActivity"
            android:exported="false"
            android:theme="@style/Theme.ProxyParser" />

    </application>

</manifest>