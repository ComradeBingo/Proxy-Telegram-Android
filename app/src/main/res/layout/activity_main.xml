<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_support">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- ОТСТУП СВЕРХУ -->
            <View
                android:layout_width="0dp"
                android:layout_height="16dp" />

            <!-- НАЗВАНИЕ ПРОГРАММЫ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Proxy for Telegram"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#2196F3"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Проверка и сортировка прокси"
                android:textSize="12sp"
                android:textColor="#383838"
                android:layout_marginBottom="16dp" />

            <!-- КНОПКА СПРАВКА -->
            <Button
                android:id="@+id/btn_help"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Справка"
                android:textSize="14sp"
                android:backgroundTint="#383838"
                android:layout_marginBottom="16dp" />

            <!-- СТАТУС ВЫПОЛНЕНИЯ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Выберите источник прокси"
                android:textSize="13sp"
                android:textColor="#383838"
                android:gravity="center"
                android:padding="12dp"
                android:background="#F5F5F5"
                android:layout_marginBottom="16dp"
                android:visibility="visible" />

            <!-- ==================== БЛОК KORT0881 ==================== -->
            <LinearLayout
                android:id="@+id/layout_kort0881"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:background="@drawable/card_background"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/header_kort0881"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kort0881"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />

                    <TextView
                        android:id="@+id/tv_kort0881_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 списка"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_kort0881_arrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="▶"
                        android:textSize="16sp"
                        android:textColor="#666666"
                        android:gravity="center" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/content_kort0881"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:id="@+id/btn_russia_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/region_button_background"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🇷🇺 Россия"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Маскировка под Яндекс, ВКонтакте, Mail.ru, Госуслуги"
                            android:textSize="12sp"
                            android:textColor="#666666" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_europe_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/region_button_background"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🇪🇺 Европа"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Маскировка под Google, Amazon, Microsoft, Cloudflare"
                            android:textSize="12sp"
                            android:textColor="#666666" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ==================== БЛОК SURFBOARD ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:background="@drawable/card_background"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SurfboardV2ray"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~300 прокси"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_surfboard"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Глобальный список"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#9C27B0" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- ЧЕРНАЯ КНОПКА ПОДДЕРЖАТЬ НА 50px ВЫШЕ ОТ НИЗА -->
    <Button
        android:id="@+id/btn_support"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🤝 ПОДДЕРЖАТЬ"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="50dp" />

</androidx.constraintlayout.widget.ConstraintLayout>