<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="400dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Название программы -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Telegram Proxies Parser"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <!-- Описание -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Парсит прокси для Telegram из открытых источников"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"
                android:gravity="center" />

            <!-- Разделитель -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginVertical="12dp" />

            <!-- Автор -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Автор: Comrade Bingo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <!-- Версия -->
            <TextView
                android:id="@+id/tv_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Версия: ..."
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:textColor="#666666" />

            <!-- Предупреждение -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#FFF3F3"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:text="ВНИМАНИЕ!\nДоступность серверов из списка не гарантирует, что все они будут работать на вашем устройстве.\nПроверяйте, пробуйте!"
                android:textColor="#FF0000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Кнопка GitHub -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_github"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="GitHub"
                    android:backgroundTint="#333333"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Кнопка закрытия -->
    <Button
        android:id="@+id/btn_close"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:text="Океюшки"
        android:backgroundTint="#0088cc" />

</LinearLayout>